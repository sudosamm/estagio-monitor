# Copie para .env e ajuste. NUNCA publique o .env.

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Domínio público configurado no Cloudflare Tunnel
ALLOWED_HOSTS=estagio.seudominio.com.br,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://estagio.seudominio.com.br

# Senha inicial de todas as contas criadas (cada pessoa troca no 1º acesso)
SENHA_PADRAO=estagio123

# Cria o 1º orientador administrador ao subir (usuário = primeiro.ultimo)
ADMIN_NOME=Seu Nome Completo

NOME_SISTEMA=Estágio Monitor
NOME_INSTITUICAO=Secretaria da Educação do Ceará
TAMANHO_MAX_ANEXO_MB=10
# Porta do servidor onde o sistema fica disponível (o Cloudflare Tunnel aponta para ela)
PORTA=8000
DEBUG=0
