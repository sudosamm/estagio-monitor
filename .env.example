# Copie para .env e ajuste. NUNCA publique o .env.

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Domínio público configurado no Cloudflare Tunnel
ALLOWED_HOSTS=estagio.seudominio.com.br,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://estagio.seudominio.com.br

# Senha inicial de todas as contas criadas (cada pessoa troca no 1º acesso)
SENHA_PADRAO=estagio123

# Cria o 1º orientador administrador ao subir (usuário = primeiro.ultimo)
ADMIN_NOME=Seu Nome Completo

NOME_SISTEMA=Estágio Monitor
NOME_INSTITUICAO=Secretaria da Educação do Ceará
TAMANHO_MAX_ANEXO_MB=10
# Porta do servidor onde o sistema fica disponível (o Cloudflare Tunnel aponta para ela)
PORTA=8000
DEBUG=0
# HTTPS obrigatório (redireciona http→https e envia HSTS). Ligue depois de confirmar que o site abre por https.
FORCAR_HTTPS=0

# Avisos por e-mail (opcional). Sem EMAIL_HOST, os avisos ficam só no sino do sistema.
# Gmail: EMAIL_HOST=smtp.gmail.com, porta 587, e uma "senha de app" (Conta Google → Segurança → Senhas de app).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remetente exibido (vazio = "Estágio Monitor <EMAIL_HOST_USER>")
EMAIL_REMETENTE=
# Endereço público usado nos links dos e-mails (vazio = o de CSRF_TRUSTED_ORIGINS)
SITE_URL=
# Resumo semanal por e-mail: sai sozinho no primeiro acesso depois de segunda, 6h.
# 0 = desliga o disparo automático (para agendar  python manage.py enviar_resumo_semanal  no Coolify).
RESUMO_AUTOMATICO=1
# Notificações no celular (Web Push). Contato exigido pelos serviços de push: https://… ou mailto:…
# Vazio = o SITE_URL (se for https). PUSH_ATIVO=0 desliga.
VAPID_CONTATO=
PUSH_ATIVO=1
# Quem recebe as mensagens da página “Sugestões e erros” (também dá para definir em Configurações)
SUGESTOES_EMAIL=
